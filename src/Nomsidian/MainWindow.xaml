<Window x:Class="Nomsidian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nomsidian"
        xmlns:services="clr-namespace:Nomsidian.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="nomsidian" Height="720" Width="1200" MinHeight="360" MinWidth="480"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource EditorBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        StateChanged="MainWindow_OnStateChanged"
        Closing="MainWindow_OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_OnExecuted" CanExecute="SaveCommand_OnCanExecute" />
    </Window.CommandBindings>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0" ResizeBorderThickness="6"
                             CornerRadius="0" UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ==================== カラーパレット（editor.html/main.js の CM6 テーマに合わせる） ==================== -->
        <SolidColorBrush x:Key="EditorBgBrush" Color="#1e1e1e" />
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#181819" />
        <SolidColorBrush x:Key="PanelBgBrush" Color="#232326" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2f2f33" />
        <SolidColorBrush x:Key="TextBrush" Color="#dcddde" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8a8a90" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8875ff" />
        <SolidColorBrush x:Key="AccentMutedBrush" Color="#4a3f8f" />
        <SolidColorBrush x:Key="HoverBrush" Color="#2a2a30" />

        <HierarchicalDataTemplate DataType="{x:Type services:FileNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Text="{Binding Converter={x:Static local:FileIconConverter.Instance}}"
                           FontFamily="Segoe UI Emoji" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type services:FileNode}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Text="{Binding Converter={x:Static local:FileIconConverter.Instance}}"
                           FontFamily="Segoe UI Emoji" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SearchMatchTemplate" DataType="{x:Type local:SearchMatch}">
            <StackPanel Margin="0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#128196;" FontFamily="Segoe UI Emoji" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Line, StringFormat=':{0}'}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding LineText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           Margin="22,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <local:SearchResultTemplateSelector x:Key="SearchResultTemplateSelector"
                                             FileNameTemplate="{StaticResource SearchResultTemplate}"
                                             MatchTemplate="{StaticResource SearchMatchTemplate}" />

        <!-- ==================== TreeView ==================== -->
        <Style x:Key="TreeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow" Data="M 0 0 L 6 4 L 0 8 Z" Fill="{DynamicResource MutedTextBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource TreeToggleStyle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="SearchResultsListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabStripStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchModeTabStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Menu ==================== -->
        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="Black" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                                   RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="24,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="Black" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== StatusBar ==================== -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="StatusBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="10,4">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ScrollBar（VSCode風の細身オーバーレイ版） ==================== -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8a8a90" Opacity="0.25" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8a8a90" Opacity="0.45" />
        <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#8a8a90" Opacity="0.6" />

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{StaticResource ScrollThumbBrush}" CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbDragBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="1,0,0,0" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="0,1,0,0" />
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== タイトルバーの自前キャプションボタン / アイコン ==================== -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== アクティビティバー（VSCode風、サイドバーの左に配置） ==================== -->
        <Style x:Key="ActivityBarButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="AccentBar" Width="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <DockPanel x:Name="TitleBar" DockPanel.Dock="Top" Height="36" Background="{DynamicResource PanelBgBrush}" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButtonStyle}" Click="SidebarToggleButton_OnClick"
                            ToolTip="サイドバーの表示切り替え">
                        <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z M3.5,0.5 L3.5,9.5"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1" Width="10" Height="10" Stretch="None" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OutlineToggleButton" Style="{StaticResource IconButtonStyle}" Click="OutlineToggleButton_OnClick"
                            ToolTip="アウトライン（見出しジャンプ）の表示切り替え">
                        <Path Data="M0.5,0.5 L9.5,0.5 M3.5,4.5 L9.5,4.5 M0.5,8.5 L9.5,8.5"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1" Width="10" Height="10" Stretch="None" />
                    </Button>
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_OnClick" ToolTip="最小化">
                        <Path Data="M0,5 H10" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1" Width="10" Height="10" Stretch="None" />
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreButton_OnClick" ToolTip="最大化">
                        <Path x:Name="MaximizeRestoreIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{DynamicResource MutedTextBrush}"
                              StrokeThickness="1" Width="10" Height="10" Stretch="None" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_OnClick" ToolTip="閉じる">
                        <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" Width="10" Height="10" Stretch="None" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock x:Name="StatusPathText" Text="ファイルが選択されていません" FontSize="12" />
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="140" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition x:Name="OutlineColumn" Width="200" MinWidth="140" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ActivityBar" Grid.Column="0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                        <ToggleButton x:Name="ExplorerToggleButton" Style="{StaticResource ActivityBarButtonStyle}"
                                      Click="ExplorerToggleButton_OnClick" ToolTip="ファイル一覧" IsChecked="True">
                            <Path Data="M0.5,2.5 L3.5,2.5 L4.5,3.5 L9.5,3.5 L9.5,8.5 L0.5,8.5 Z"
                                  Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </ToggleButton>
                        <ToggleButton x:Name="SearchToggleButton" Style="{StaticResource ActivityBarButtonStyle}"
                                      Click="SearchToggleButton_OnClick" ToolTip="検索">
                            <Canvas Width="16" Height="16">
                                <Ellipse Canvas.Left="0" Canvas.Top="0" Width="11" Height="11"
                                         Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" />
                                <Line X1="9.8" Y1="9.8" X2="16" Y2="16" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.6" />
                            </Canvas>
                        </ToggleButton>
                        <ToggleButton x:Name="FavoritesToggleButton" Style="{StaticResource ActivityBarButtonStyle}"
                                      Click="FavoritesToggleButton_OnClick" ToolTip="お気に入り">
                            <Path Data="M1.5,0.5 L12.5,0.5 L12.5,15.5 L7,10.5 L1.5,15.5 Z"
                                  Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <DockPanel x:Name="SidebarPanel" Grid.Column="1" Background="{DynamicResource SidebarBgBrush}">
                    <Border DockPanel.Dock="Top" Padding="14,12,14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="SidebarHeaderText" Text="FILES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                    <Grid>
                        <TreeView x:Name="FileTree" SelectedItemChanged="FileTree_OnSelectedItemChanged"
                                  ContextMenuOpening="FileTree_OnContextMenuOpening">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="AddToFavoritesMenuItem" Header="お気に入りに追加"
                                              Style="{StaticResource SubMenuItemStyle}" Click="AddToFavoritesMenuItem_OnClick" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                        <DockPanel x:Name="SearchPanel" Visibility="Collapsed">
                            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="8,8,8,0">
                                <ToggleButton x:Name="SearchModeFileNameButton" Content="ファイル名" Tag="FileName"
                                              Style="{StaticResource SearchModeTabStyle}" IsChecked="True"
                                              Click="SearchModeButton_OnClick" />
                                <ToggleButton x:Name="SearchModeInFileButton" Content="ファイル内" Tag="InFile"
                                              Style="{StaticResource SearchModeTabStyle}"
                                              Click="SearchModeButton_OnClick" />
                                <ToggleButton x:Name="SearchModeCrossFileButton" Content="全文" Tag="CrossFile"
                                              Style="{StaticResource SearchModeTabStyle}"
                                              Click="SearchModeButton_OnClick" />
                            </UniformGrid>
                            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBoxStyle}"
                                     Margin="8,8,8,4" TextChanged="SearchBox_OnTextChanged" />
                            <ListBox x:Name="SearchResultsList" Style="{StaticResource SearchResultsListStyle}"
                                     ItemTemplateSelector="{StaticResource SearchResultTemplateSelector}"
                                     SelectionChanged="SearchResultsList_OnSelectionChanged" />
                        </DockPanel>
                        <DockPanel x:Name="FavoritesPanel" Visibility="Collapsed">
                            <ListBox x:Name="FavoritesList" Style="{StaticResource SearchResultsListStyle}"
                                     ItemTemplate="{StaticResource SearchResultTemplate}"
                                     SelectionChanged="FavoritesList_OnSelectionChanged" />
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <Border x:Name="SidebarSplitterBorder" Grid.Column="2" Background="{DynamicResource BorderBrush}" />
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <DockPanel Grid.Column="3">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <ListBox x:Name="TabStrip" Style="{StaticResource TabStripStyle}"
                                 SelectionChanged="TabStrip_OnSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="4,4,0,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:OpenDocument}">
                                    <StackPanel Orientation="Horizontal" Margin="10,5">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <Button Content="&#10005;" Tag="{Binding}" Click="TabCloseButton_OnClick"
                                                Style="{StaticResource TabCloseButtonStyle}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <wv2:WebView2 x:Name="EditorView" />
                </DockPanel>

                <Border x:Name="OutlineSplitterBorder" Grid.Column="4" Background="{DynamicResource BorderBrush}" />
                <GridSplitter x:Name="OutlineSplitter" Grid.Column="4" Width="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <DockPanel x:Name="OutlinePanel" Grid.Column="5" Background="{DynamicResource SidebarBgBrush}">
                    <Border DockPanel.Dock="Top" Padding="14,12,14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="OUTLINE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                    <Grid>
                        <TextBlock Text="見出しがありません" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   Margin="14,10" TextWrapping="Wrap"
                                   Visibility="{Binding Items.Count, ElementName=OutlineList, Converter={x:Static local:ZeroToVisibleConverter.Instance}}" />
                        <ListBox x:Name="OutlineList" Style="{StaticResource SearchResultsListStyle}"
                                 SelectionChanged="OutlineList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HeadingItem}">
                                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" Margin="{Binding IndentWidth, Converter={x:Static local:IndentToThicknessConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
