<Window x:Class="Nomsidian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nomsidian"
        xmlns:services="clr-namespace:Nomsidian.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="nomsidian" Height="720" Width="1200">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type services:MarkdownFileNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..." Click="OpenMenuItem_OnClick" InputGestureText="Ctrl+O" />
                <MenuItem Header="保存(_S)" Click="SaveMenuItem_OnClick" InputGestureText="Ctrl+S" />
                <MenuItem Header="名前を付けて保存(_A)..." Click="SaveAsMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="ExitMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusPathText" Text="ファイルが選択されていません" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FileTree"
                      Grid.Column="0"
                      SelectedItemChanged="FileTree_OnSelectedItemChanged" />

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3a3a3a" />

            <wv2:WebView2 x:Name="EditorView" Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
